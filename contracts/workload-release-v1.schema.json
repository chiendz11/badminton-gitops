{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "component",
    "image",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "environment": {
      "const": "production"
    },
    "component": {
      "enum": [
        "web",
        "admin",
        "api-gateway",
        "identity-service",
        "booking-core",
        "commerce-service",
        "social-service",
        "content-service",
        "notification-service",
        "storage-service",
        "ai-service"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "migration_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "chiendz11/badminton_system"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    }
  }
}
